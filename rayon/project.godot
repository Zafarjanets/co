; Engine configuration file.
; Godot 4.3+

config_version=5

[application]

config/name="РАЙОН / RAYON"
config/description="Аркадная 3D-игра: открытый район, вождение, дрифт, задания и полиция."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=6
common/physics_jitter_fix=0.0

[rendering]

rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/default_filters/anisotropic_filtering_level=0
environment/defaults/default_clear_color=Color(0.53, 0.78, 0.96, 1)
